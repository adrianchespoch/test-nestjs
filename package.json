{
  "name": "nestapi",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev2": "nest start --watch --host 0.0.0.0",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",

    "typeorm:dist": "node ./node_modules/typeorm/cli.js -d dist/config/typeorm.datasource.js",
    "migration:run:docker": "node ./node_modules/typeorm/cli.js -d dist/config/typeorm.datasource.js migration:run",

    "lint": "eslint \"{src,test}/**/*.ts\" --fix",

    "test": "jest --config ./test/jest-unit.json",
    "test:watch": "jest --config ./test/jest-unit.json --watch",
    "test:cov": "jest --config ./test/jest-unit.json --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",

    "migration:generate": "pnpm build && pnpm typeorm:dist migration:generate",
    "migration:generate2": "pnpm build && pnpm typeorm:dist migration:generate src/migrations/migration",
    "migration:run": "pnpm build && pnpm typeorm:dist migration:run",
    "migration:show": "pnpm build && pnpm typeorm:dist migration:show",
    "migration:revert": "pnpm build && pnpm typeorm:dist migration:revert",

    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down -v",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit",
    "e2e:docker:down": "docker compose -f docker-compose.e2e.yml down -v"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.8.2",
    "mysql2": "^3.16.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
