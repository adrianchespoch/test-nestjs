# Runtime
NODE_ENV=dev
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
APP_URL=http://localhost:3000

# Database (Postgres 17)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skeleton?schema=public&connection_limit=10
POSTGRES_DB=skeleton
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_REQUIRED=true

# Cookies
COOKIE_SECRET=change-this-to-32-or-more-chars-please
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=Strict

# JWT (RS256). Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Mailer (dev: maildev/mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# Argon2id (OWASP 2026 baseline)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Throttler
RATE_LIMIT_LOGIN_PER_10MIN=5
ACCOUNT_LOCKOUT_MINUTES=15

# OpenTelemetry (optional)
OTEL_SERVICE_NAME=nestjs-skeleton
OTEL_EXPORTER_OTLP_ENDPOINT=

# Build metadata (injected by CI)
COMMIT_SHA=local
